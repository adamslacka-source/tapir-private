{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facade-spec/1#I7b",
  "title": "facade-spec/1 - subset for increments I1-I6 + pilot A (reference, planes, stories, zones[wall], openings, cw_fields, balconies, railings, linear, objects, systems catalog; pilot B: freestanding curtain walls, slabs, brackets, louvres, per-element stories)",
  "description": "Machine specification of one facade (ADR-001, ch. 4). Local facade coordinates: s = m along the reference line a->b (left to right seen from outside), v = m above reference.z0, w = m out of the facade plane. Every number that drives the model carries a source (src) and a certainty (conf).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "reference",
    "sources",
    "stories",
    "zones",
    "openings",
    "systems",
    "tolerances"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "facade-spec/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "title": {
      "type": "string"
    },
    "generated": {
      "type": "object",
      "description": "Provenance of the spec file (adapter, time, source files)."
    },
    "reference": {
      "type": "object",
      "required": [
        "a",
        "b",
        "z0",
        "outside",
        "layer",
        "src",
        "conf"
      ],
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/xy",
          "description": "left end of the facade seen from outside, model coordinates (m)"
        },
        "b": {
          "$ref": "#/$defs/xy",
          "description": "right end of the facade seen from outside, model coordinates (m)"
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "z0": {
          "$ref": "#/$defs/value",
          "description": "absolute model z of v = 0 (foot of the facade)"
        },
        "outside": {
          "enum": [
            "right_of_ab",
            "left_of_ab"
          ]
        },
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "home_story": {
          "type": "object",
          "required": [
            "floorIndex",
            "src",
            "conf"
          ],
          "additionalProperties": false,
          "properties": {
            "floorIndex": {
              "type": "integer"
            },
            "src": {
              "$ref": "#/$defs/src"
            },
            "conf": {
              "$ref": "#/$defs/conf"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "joins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a": {
              "$ref": "#/$defs/planeId"
            },
            "b": {
              "$ref": "#/$defs/planeId"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "file"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "photo",
              "script",
              "survey",
              "drawing",
              "sketch",
              "archicad",
              "rule",
              "iteration"
            ]
          },
          "file": {
            "type": "string"
          },
          "rect": {
            "type": "object",
            "description": "metric rectified image: pixel x = (s - u0) * S, y = (v1 - v) * S",
            "required": [
              "image",
              "S",
              "u0",
              "v1",
              "size"
            ],
            "properties": {
              "image": {
                "type": "string"
              },
              "S": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "u0": {
                "type": "number"
              },
              "v1": {
                "type": "number"
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "$ref": "#/$defs/value"
          },
          "note": {
            "type": "string"
          },
          "floorIndex": {
            "type": "integer",
            "description": "Archicad story index; when every story has one, every element gets the story its foot stands on"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "s": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "snap_tol": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "rect",
          "thickness",
          "system"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "kind": {
            "const": "wall"
          },
          "rect": {
            "$ref": "#/$defs/rect"
          },
          "thickness": {
            "$ref": "#/$defs/value"
          },
          "system": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "plane": {
            "$ref": "#/$defs/planeId"
          },
          "w": {
            "$ref": "#/$defs/value",
            "description": "offset of the outside face of the zone from its plane (m, + = out; a rizalit, a cladding standing in front of the render)"
          },
          "role": {
            "enum": [
              "main",
              "parter",
              "rizalit",
              "side",
              "corner",
              "gable"
            ],
            "description": "what the zone is (information, G1)"
          }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "rect",
          "system"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "kind": {
            "enum": [
              "window",
              "door",
              "opening"
            ]
          },
          "zone": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "rect": {
            "$ref": "#/$defs/rect"
          },
          "kind_src": {
            "$ref": "#/$defs/src"
          },
          "kind_conf": {
            "$ref": "#/$defs/conf"
          },
          "system": {
            "type": "string"
          },
          "reveal": {
            "$ref": "#/$defs/value"
          },
          "glazing": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "transom_h": {
            "$ref": "#/$defs/value",
            "description": "height of the transom zone from the top of the wall hole (m)"
          },
          "sidelight_w": {
            "$ref": "#/$defs/value",
            "description": "visible width of a sidelight inside this opening (m)"
          },
          "sidelight_sill": {
            "$ref": "#/$defs/value",
            "description": "height of the wall parapet under the sidelight, from the bottom of the opening (m)"
          },
          "transom_bars": {
            "$ref": "#/$defs/value",
            "description": "number of horizontal bars inside the transom above the leaf (0/1)"
          },
          "transom_bar_h": {
            "$ref": "#/$defs/value",
            "description": "height of the division inside the transom above the leaf (library parameter, m)"
          },
          "bar_h": {
            "$ref": "#/$defs/value",
            "description": "height of the centre of the horizontal glazing bar above the bottom of the wall hole (m)"
          },
          "merged_into": {
            "type": "string",
            "description": "id of the opening this one is built with as ONE element (e.g. a shop window that is the sidelight of a door, one frame on the photo). Its rect stays the photo reading; the build derives sidelight width / parapet of the host from it."
          },
          "photo_edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/photoEdge"
            }
          },
          "shoulder_h": {
            "$ref": "#/$defs/value",
            "description": "arch door / window: height of the springing above the bottom of the wall hole (m)"
          },
          "head_in": {
            "type": "string",
            "description": "id of the object (arch gable) that carries the arched head of this opening above the top of its wall zone"
          },
          "rect_pilot": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "rect of the pilot source when the spec corrects it (record)"
          },
          "transom_cols": {
            "$ref": "#/$defs/value",
            "description": "number of panes side by side in the transom above the leaf (1 = no vertical bar)"
          }
        }
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "conf"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "wall",
              "window",
              "door",
              "profile",
              "linear",
              "gdl",
              "curtain_wall",
              "slab",
              "railing"
            ]
          },
          "favorite": {
            "type": [
              "string",
              "null"
            ],
            "description": "Archicad Favorite the elements are placed from. With base_favorite it is the FS favourite created by systems.py (name must start with 'FS '); without it an existing favourite (I1)."
          },
          "structure": {
            "enum": [
              "Basic",
              "Composite",
              "Profile"
            ]
          },
          "reference_line": {
            "enum": [
              "Outside",
              "Center",
              "Inside",
              "CoreOutside",
              "CoreCenter",
              "CoreInside"
            ]
          },
          "nominal": {
            "enum": [
              "wallhole"
            ],
            "description": "what width/height of the library part mean; wallhole = the masonry opening seen on the facade"
          },
          "conf": {
            "$ref": "#/$defs/conf"
          },
          "src": {
            "$ref": "#/$defs/src"
          },
          "note": {
            "type": "string"
          },
          "base_favorite": {
            "type": "string",
            "description": "existing Favorite the FS favourite starts from (sample element, ADR D4)"
          },
          "libpart": {
            "type": "string",
            "description": "library part the base favourite places; must be listed in gdl_param_map.json"
          },
          "leaves": {
            "$ref": "#/$defs/anyValue",
            "description": "number of leaves / sashes"
          },
          "transom": {
            "$ref": "#/$defs/anyValue",
            "description": "has a transom (fanlight)"
          },
          "sidelight": {
            "$ref": "#/$defs/anyValue",
            "description": "'none' | 'right' | 'left' seen from outside"
          },
          "sash_bars": {
            "$ref": "#/$defs/anyValue",
            "description": "horizontal glazing bars per sash (0/1)"
          },
          "frame_surface": {
            "$ref": "#/$defs/anyValue",
            "description": "Archicad surface name of the outside of frame and leaves"
          },
          "composite": {
            "type": "object",
            "required": [
              "name",
              "skins"
            ],
            "additionalProperties": false,
            "description": "Composite attribute of a wall system; skins listed from the OUTSIDE (reference line 'Outside') to the inside; the sum must equal the zone thickness.",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^FS "
              },
              "skins": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "material",
                    "thickness"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "Core",
                        "Finish",
                        "Other"
                      ]
                    },
                    "material": {
                      "type": "string",
                      "description": "Archicad building material name"
                    },
                    "thickness": {
                      "$ref": "#/$defs/value"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "leaf_panel": {
            "$ref": "#/$defs/anyValue",
            "description": "leaf panel style of the library part (e.g. iDoorPanelType)"
          },
          "base_libpart": {
            "type": "boolean",
            "description": "the FS favourite starts from a sample placed by CreateDoors/CreateWindows.libraryPartName = libpart (a part without a favourite in the template; Tapir T7)"
          },
          "name": {
            "type": "string",
            "pattern": "^FS ",
            "description": "profile: name of the Archicad Profile attribute"
          },
          "polygon_wv": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/xy"
            },
            "description": "profile: cross-section, x = w (m out of the facade plane, >= 0), y = m above the base of the element (beam) or along the facade (column); counter-clockwise or clockwise, not closed"
          },
          "material": {
            "type": "string",
            "description": "building material name (profile / composite)"
          },
          "edge_surface": {
            "type": "string",
            "description": "profile: surface of every edge"
          },
          "w": {
            "$ref": "#/$defs/value",
            "description": "profile: projection out of the facade (m)"
          },
          "h": {
            "$ref": "#/$defs/value",
            "description": "profile: height (beam) / width along the facade (column) (m)"
          },
          "tool": {
            "enum": [
              "beam",
              "column"
            ],
            "description": "linear: Archicad tool; beam = horizontal (profile x = out, y = up), column = vertical (profile x = out, y = along the facade)"
          },
          "profile": {
            "type": "string",
            "description": "linear: id of the profile system"
          },
          "template": {
            "type": "string",
            "pattern": "^FS_",
            "description": "gdl: FS template (facade/gdl/templates)"
          },
          "corner_profile": {
            "type": "boolean",
            "description": "profile of an element that runs round a corner (wrap): x may be < 0 (behind the plane, along the other facade)"
          },
          "classification": {
            "type": "string",
            "description": "gdl: classification item (its ID, unique in the project) given to the placed objects - needed for the FS_* properties"
          },
          "frame": {
            "type": "object",
            "required": [
              "width",
              "depth",
              "offset"
            ],
            "additionalProperties": false,
            "description": "mullions and transoms of the curtain wall (one frame class 'FS <system> rám')",
            "properties": {
              "width": {
                "$ref": "#/$defs/value"
              },
              "depth": {
                "$ref": "#/$defs/value"
              },
              "offset": {
                "$ref": "#/$defs/value"
              },
              "material": {
                "type": "string",
                "description": "building material name"
              },
              "surface": {
                "type": "string",
                "description": "surface name"
              }
            }
          },
          "boundary": {
            "type": "object",
            "required": [
              "width",
              "depth",
              "offset"
            ],
            "additionalProperties": false,
            "description": "boundary frames of the curtain wall (edge of the field = jamb, head, sill)",
            "properties": {
              "width": {
                "$ref": "#/$defs/value"
              },
              "depth": {
                "$ref": "#/$defs/value"
              },
              "offset": {
                "$ref": "#/$defs/value"
              },
              "material": {
                "type": "string",
                "description": "building material name"
              },
              "surface": {
                "type": "string",
                "description": "surface name"
              }
            }
          },
          "panels": {
            "type": "object",
            "description": "panel kinds of the curtain wall -> panel class 'FS <system> <kind>': glass / opaque (thickness, material, surface) or a door panel (libpart, e.g. 'CW Door 27')",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "thickness": {
                  "$ref": "#/$defs/value"
                },
                "material": {
                  "type": "string"
                },
                "surface": {
                  "type": "string"
                },
                "libpart": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "thickness": {
            "$ref": "#/$defs/value",
            "description": "slab thickness"
          },
          "height": {
            "$ref": "#/$defs/value",
            "description": "railing height above its base (top of the top rail)"
          },
          "post_spacing": {
            "$ref": "#/$defs/value",
            "description": "railing pattern length = distance of the posts"
          },
          "post_distribution": {
            "enum": [
              "FixedLength",
              "BestDivision"
            ]
          },
          "baluster_spacing": {
            "$ref": "#/$defs/value",
            "description": "distance of the balusters (bars) of the infill"
          },
          "infill": {
            "$ref": "#/$defs/anyValue",
            "description": "railing infill: balusters / panel / rails"
          },
          "favorite_baluster_spacing": {
            "type": "number",
            "description": "baluster spacing the base favourite carries (fixed by the favourite: ModifyRailingDetails cannot change it, R1)"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "value",
          "why",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "value": {},
          "conf": {
            "$ref": "#/$defs/conf"
          },
          "why": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "changed"
            ]
          }
        }
      }
    },
    "tolerances": {
      "type": "object",
      "required": [
        "build"
      ],
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "model vs spec, read back from Archicad (m)"
        },
        "kota": {
          "type": [
            "number",
            "null"
          ]
        },
        "meranie": {
          "type": [
            "number",
            "null"
          ]
        },
        "pravidlo": {
          "type": [
            "number",
            "null"
          ]
        },
        "odhad": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "g1_proposals": {
      "type": "object",
      "description": "gate G1: proposed value per assumption ref (text for the architect)",
      "additionalProperties": {
        "type": "string"
      }
    },
    "simplifications": {
      "type": "array",
      "description": "what the model deliberately does differently from the source (listed in G1)",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "text",
          "proposal"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "proposal": {
            "type": "string"
          }
        }
      }
    },
    "linear": {
      "type": "array",
      "description": "I3: linear elements of the facade (cornices, string courses, sill ledges, surrounds) as profiled beams / columns",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "system",
          "axis",
          "s",
          "v"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "kind": {
            "enum": [
              "cornice",
              "cordon",
              "plinth",
              "band",
              "sill_ledge",
              "surround_head",
              "surround_jamb",
              "attic",
              "eaves",
              "sill",
              "pilaster",
              "corner_pilaster",
              "bracket",
              "column",
              "eaves"
            ]
          },
          "system": {
            "type": "string"
          },
          "axis": {
            "enum": [
              "h",
              "v",
              "w"
            ],
            "description": "h = horizontal (s = [s0, s1], v = base of the profile); v = vertical (s = [s0, s1] = band across the facade, v = [v0, v1]); w = beam perpendicular to the facade (s = [s0, s1] = width of the profile, w_span = [w0, w1], v = base)"
          },
          "host": {
            "type": "string",
            "description": "opening the element belongs to (surround, sill ledge)"
          },
          "s": {
            "$ref": "#/$defs/range"
          },
          "v": {
            "oneOf": [
              {
                "$ref": "#/$defs/value"
              },
              {
                "$ref": "#/$defs/range"
              }
            ]
          },
          "photo_edges": {
            "type": "array",
            "description": "edges checked on the rectified photo (verify overlay): corner of the profile projected with the camera of the photo",
            "items": {
              "type": "object",
              "required": [
                "name",
                "corner",
                "s",
                "brighter"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "corner": {
                  "enum": [
                    "bottom_front",
                    "top_front",
                    "bottom_back",
                    "top_back"
                  ]
                },
                "s": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "brighter": {
                  "enum": [
                    "above",
                    "below"
                  ]
                },
                "photo_v": {
                  "type": "number",
                  "description": "edge read by hand (for the record)"
                },
                "tol": {
                  "type": "number"
                },
                "search": {
                  "type": "number",
                  "description": "half height of the search band in the photo around the projected model edge (m), default 0.06"
                },
                "axis": {
                  "enum": [
                    "v"
                  ]
                }
              }
            }
          },
          "note": {
            "type": "string"
          },
          "plane": {
            "$ref": "#/$defs/planeId"
          },
          "w": {
            "$ref": "#/$defs/value",
            "description": "offset of the back of the profile from the plane (m), e.g. on the face of a rizalit"
          },
          "wrap": {
            "enum": [
              "a",
              "b"
            ],
            "description": "the element runs round the corner at end a / b of its plane (the plane joins another there): s may go beyond 0..L by the profile, a corner profile may reach behind the plane"
          },
          "w_span": {
            "$ref": "#/$defs/range",
            "description": "axis w: from w0 to w1 out of the plane"
          },
          "story": {
            "type": "string"
          }
        }
      }
    },
    "planes": {
      "type": "array",
      "description": "further facade planes of the same spec (e.g. the side facade at a corner = nárožie); the reference is plane 'F'. Same z0 as the reference.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "a",
          "b",
          "outside",
          "src",
          "conf"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/planeId"
          },
          "a": {
            "$ref": "#/$defs/xy"
          },
          "b": {
            "$ref": "#/$defs/xy"
          },
          "outside": {
            "enum": [
              "right_of_ab",
              "left_of_ab"
            ]
          },
          "src": {
            "$ref": "#/$defs/src"
          },
          "conf": {
            "$ref": "#/$defs/conf"
          },
          "photo": {
            "type": [
              "string",
              "null"
            ],
            "description": "source id of a rectified photo of this plane, null = none (no overlay)"
          },
          "joins": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "a": {
                "$ref": "#/$defs/planeId"
              },
              "b": {
                "$ref": "#/$defs/planeId"
              }
            },
            "description": "plane that meets this one at its end a / b (corner); the reference may list its joins in reference.joins"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "description": "GDL objects of the facade from FS templates (surrounds, arch gables)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "system",
          "origin",
          "params"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "kind": {
            "enum": [
              "surround",
              "arch_gable",
              "louvers"
            ]
          },
          "system": {
            "type": "string"
          },
          "plane": {
            "$ref": "#/$defs/planeId"
          },
          "host": {
            "type": "string",
            "description": "opening the object belongs to"
          },
          "zone": {
            "type": "string",
            "description": "wall zone the object sits on (arch gable: on top of it)"
          },
          "over": {
            "type": "string",
            "description": "arch gable: the opening right under the arch (its head = the springing, its half width = the inner chord)"
          },
          "origin": {
            "type": "object",
            "required": [
              "v",
              "src",
              "conf"
            ],
            "additionalProperties": false,
            "properties": {
              "v": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "src": {
                "$ref": "#/$defs/src"
              },
              "conf": {
                "$ref": "#/$defs/conf"
              },
              "note": {
                "type": "string"
              }
            },
            "description": "[s, v, w] of the local origin of the template"
          },
          "params": {
            "type": "object",
            "description": "GDL parameter -> value (numbers / booleans; a Material parameter takes a surface name)",
            "additionalProperties": {
              "$ref": "#/$defs/anyValue"
            }
          },
          "photo_edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/photoEdge"
            }
          },
          "note": {
            "type": "string"
          },
          "story": {
            "type": "string"
          }
        }
      }
    },
    "cw_fields": {
      "type": "array",
      "description": "glazed fields (shop windows, glazed entrances) as Curtain Walls: a CW in a rectangular hole of the wall of its zone (Empty Window), raster = inner axes",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rect",
          "system",
          "reveal"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "zone": {
            "type": "string"
          },
          "rect": {
            "$ref": "#/$defs/rect"
          },
          "system": {
            "type": "string"
          },
          "replaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "openings of the earlier spec the field replaces"
          },
          "u_axes": {
            "$ref": "#/$defs/valueList",
            "description": "s of the mullion axes inside the field, ascending"
          },
          "v_axes": {
            "$ref": "#/$defs/valueList",
            "description": "v of the transom axes inside the field, ascending"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "col",
                "row",
                "panel"
              ],
              "additionalProperties": false,
              "properties": {
                "col": {
                  "type": "integer",
                  "minimum": 0
                },
                "row": {
                  "type": "integer",
                  "minimum": 0
                },
                "panel": {
                  "type": "string"
                }
              }
            }
          },
          "reveal": {
            "$ref": "#/$defs/value",
            "description": "outer face of the frames behind the outside face of the zone wall; without zone (freestanding CW, pilot B): outer face of the frames behind the reference plane of the facade"
          },
          "photo_edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/photoEdge"
            }
          },
          "note": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "plane": {
            "$ref": "#/$defs/planeId"
          },
          "photo_w": {
            "$ref": "#/$defs/value",
            "description": "w of the plane the axes were read on in the photo (pilot B ground floor: the blind plane in front of the glazing)"
          }
        },
        "description": "glazed field as a Curtain Wall: in a hole of the wall of its zone (zone given) or freestanding in front of / behind the plane (no zone, pilot B)"
      }
    },
    "balconies": {
      "type": "array",
      "description": "balcony slabs in front of the facade: back edge on the wall faces, sides to w_side, circular front through the crown w_crown",
      "items": {
        "type": "object",
        "required": [
          "id",
          "s",
          "w_side",
          "w_crown",
          "v_top",
          "system"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "plane": {
            "$ref": "#/$defs/planeId"
          },
          "host": {
            "type": "string"
          },
          "system": {
            "type": "string"
          },
          "s": {
            "$ref": "#/$defs/valueList"
          },
          "w_side": {
            "$ref": "#/$defs/value"
          },
          "w_crown": {
            "$ref": "#/$defs/value"
          },
          "v_top": {
            "$ref": "#/$defs/value"
          },
          "front": {
            "enum": [
              "arc"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "railings": {
      "type": "array",
      "description": "railings (I6): reference line in (s, w) of a plane at the base v; straight segments only",
      "items": {
        "type": "object",
        "required": [
          "id",
          "system",
          "path_sw",
          "v"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "plane": {
            "$ref": "#/$defs/planeId"
          },
          "on": {
            "type": "string",
            "description": "balcony or slab (walkway) it stands on"
          },
          "system": {
            "type": "string"
          },
          "path_sw": {
            "$ref": "#/$defs/pointList"
          },
          "v": {
            "$ref": "#/$defs/value"
          },
          "inset": {
            "type": "number"
          },
          "chords": {
            "type": "integer",
            "minimum": 1
          },
          "approx_error": {
            "type": "number",
            "description": "largest distance of the chords from the arc (m)"
          },
          "note": {
            "type": "string"
          },
          "story": {
            "type": "string"
          }
        }
      }
    },
    "slabs": {
      "type": "array",
      "description": "pilot B: slabs given by their outline in (s, w) of a plane (walkway, slab edge strip)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "system",
          "outline_sw",
          "v_top"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/itemId"
          },
          "kind": {
            "enum": [
              "walkway",
              "floor_edge",
              "roof"
            ]
          },
          "system": {
            "type": "string"
          },
          "plane": {
            "$ref": "#/$defs/planeId"
          },
          "outline_sw": {
            "$ref": "#/$defs/pointList"
          },
          "v_top": {
            "$ref": "#/$defs/value"
          },
          "story": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "xy": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "itemId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "src": {
      "type": [
        "string",
        "null"
      ],
      "description": "id of an entry in sources, or null when there is no source (conf odhad/default)"
    },
    "conf": {
      "enum": [
        "kota",
        "meranie",
        "pravidlo",
        "odhad",
        "default"
      ]
    },
    "value": {
      "type": "object",
      "required": [
        "v",
        "src",
        "conf"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "number"
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "rect": {
      "type": "object",
      "required": [
        "v",
        "src",
        "conf"
      ],
      "additionalProperties": false,
      "description": "v = [s0, s1, v0, v1] in metres",
      "properties": {
        "v": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "note": {
          "type": "string"
        },
        "edge_conf": {
          "type": "object",
          "additionalProperties": false,
          "description": "per-edge certainty overriding conf of the rect (G2 kolo 2, N1): an edge hidden on the photo (e.g. a lintel behind a shop sign) is 'odhad' with the reason in note - the automatic photo check reports it as 'zakrytá', the I7 loop never measures or corrects it",
          "properties": {
            "left": {
              "type": "object",
              "required": [
                "conf",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "conf": {
                  "$ref": "#/$defs/conf"
                },
                "note": {
                  "type": "string"
                },
                "src": {
                  "$ref": "#/$defs/src"
                }
              }
            },
            "right": {
              "type": "object",
              "required": [
                "conf",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "conf": {
                  "$ref": "#/$defs/conf"
                },
                "note": {
                  "type": "string"
                },
                "src": {
                  "$ref": "#/$defs/src"
                }
              }
            },
            "bottom": {
              "type": "object",
              "required": [
                "conf",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "conf": {
                  "$ref": "#/$defs/conf"
                },
                "note": {
                  "type": "string"
                },
                "src": {
                  "$ref": "#/$defs/src"
                }
              }
            },
            "top": {
              "type": "object",
              "required": [
                "conf",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "conf": {
                  "$ref": "#/$defs/conf"
                },
                "note": {
                  "type": "string"
                },
                "src": {
                  "$ref": "#/$defs/src"
                }
              }
            }
          }
        }
      }
    },
    "anyValue": {
      "type": "object",
      "required": [
        "v",
        "src",
        "conf"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": [
            "number",
            "integer",
            "boolean",
            "string"
          ]
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "v",
        "src",
        "conf"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "planeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "'F' = the reference plane, else the id of an entry of planes"
    },
    "photoEdge": {
      "type": "object",
      "required": [
        "name",
        "edge",
        "range",
        "brighter"
      ],
      "additionalProperties": false,
      "description": "edge of an opening / object checked on the rectified photo: model edge (3D, projected with the camera of the photo) vs the strongest brightness step of the given sign near it",
      "properties": {
        "name": {
          "type": "string"
        },
        "edge": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "window along the edge: v range for left/right, s range for top/bottom (m)"
        },
        "brighter": {
          "enum": [
            "left",
            "right",
            "above",
            "below"
          ]
        },
        "photo": {
          "type": "number",
          "description": "edge read by hand (for the record)"
        },
        "tol": {
          "type": "number"
        },
        "search": {
          "type": "number"
        }
      }
    },
    "valueList": {
      "type": "object",
      "required": [
        "v",
        "src",
        "conf"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pointList": {
      "type": "object",
      "required": [
        "v",
        "src",
        "conf"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xy"
          },
          "minItems": 2
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
