{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facade-spec/1#I1",
  "title": "facade-spec/1 - subset for increment I1 (reference, stories, zones[wall], openings)",
  "description": "Machine specification of one facade (ADR-001, ch. 4). Local facade coordinates: s = m along the reference line a->b (left to right seen from outside), v = m above reference.z0, w = m out of the facade plane. Every number that drives the model carries a source (src) and a certainty (conf).",
  "type": "object",
  "required": ["schema", "id", "reference", "sources", "stories", "zones", "openings", "systems", "tolerances"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "facade-spec/1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "title": {"type": "string"},
    "generated": {"type": "object", "description": "Provenance of the spec file (adapter, time, source files)."},
    "reference": {
      "type": "object",
      "required": ["a", "b", "z0", "outside", "layer", "src", "conf"],
      "additionalProperties": false,
      "properties": {
        "a": {"$ref": "#/$defs/xy", "description": "left end of the facade seen from outside, model coordinates (m)"},
        "b": {"$ref": "#/$defs/xy", "description": "right end of the facade seen from outside, model coordinates (m)"},
        "src": {"$ref": "#/$defs/src"},
        "conf": {"$ref": "#/$defs/conf"},
        "z0": {"$ref": "#/$defs/value", "description": "absolute model z of v = 0 (foot of the facade)"},
        "outside": {"enum": ["right_of_ab", "left_of_ab"]},
        "layer": {"type": "string", "minLength": 1},
        "home_story": {
          "type": "object",
          "required": ["floorIndex", "src", "conf"],
          "additionalProperties": false,
          "properties": {
            "floorIndex": {"type": "integer"},
            "src": {"$ref": "#/$defs/src"},
            "conf": {"$ref": "#/$defs/conf"},
            "note": {"type": "string"}
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "file"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["photo", "script", "survey", "drawing", "sketch", "archicad", "rule"]},
          "file": {"type": "string"},
          "rect": {
            "type": "object",
            "description": "metric rectified image: pixel x = (s - u0) * S, y = (v1 - v) * S",
            "required": ["image", "S", "u0", "v1", "size"],
            "properties": {
              "image": {"type": "string"},
              "S": {"type": "number", "exclusiveMinimum": 0},
              "u0": {"type": "number"},
              "v1": {"type": "number"},
              "size": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level"],
        "additionalProperties": false,
        "properties": {"id": {"type": "string"}, "level": {"$ref": "#/$defs/value"}, "note": {"type": "string"}}
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"s": {"type": "array", "items": {"type": "number"}}, "snap_tol": {"type": "number", "minimum": 0}}
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "rect", "thickness", "system"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/itemId"},
          "kind": {"const": "wall"},
          "rect": {"$ref": "#/$defs/rect"},
          "thickness": {"$ref": "#/$defs/value"},
          "system": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "rect", "system"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/itemId"},
          "kind": {"enum": ["window", "door", "opening"]},
          "zone": {"type": "string"},
          "story": {"type": "string"},
          "rect": {"$ref": "#/$defs/rect"},
          "kind_src": {"$ref": "#/$defs/src"},
          "kind_conf": {"$ref": "#/$defs/conf"},
          "system": {"type": "string"},
          "reveal": {"$ref": "#/$defs/value"},
          "glazing": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "conf"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["wall", "window", "door"]},
          "favorite": {"type": ["string", "null"], "description": "existing Archicad Favorite; null = tool defaults"},
          "structure": {"enum": ["Basic", "Composite", "Profile"]},
          "reference_line": {"enum": ["Outside", "Center", "Inside", "CoreOutside", "CoreCenter", "CoreInside"]},
          "nominal": {"enum": ["wallhole"], "description": "what width/height of the library part mean; wallhole = the masonry opening seen on the facade"},
          "conf": {"$ref": "#/$defs/conf"},
          "src": {"$ref": "#/$defs/src"},
          "note": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "value", "why", "status"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string"},
          "value": {},
          "conf": {"$ref": "#/$defs/conf"},
          "why": {"type": "string"},
          "status": {"enum": ["pending", "approved", "changed"]}
        }
      }
    },
    "tolerances": {
      "type": "object",
      "required": ["build"],
      "additionalProperties": false,
      "properties": {
        "build": {"type": "number", "exclusiveMinimum": 0, "description": "model vs spec, read back from Archicad (m)"},
        "kota": {"type": ["number", "null"]},
        "meranie": {"type": ["number", "null"]},
        "pravidlo": {"type": ["number", "null"]},
        "odhad": {"type": ["number", "null"]}
      }
    }
  },
  "$defs": {
    "xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "itemId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "src": {"type": ["string", "null"], "description": "id of an entry in sources, or null when there is no source (conf odhad/default)"},
    "conf": {"enum": ["kota", "meranie", "pravidlo", "odhad", "default"]},
    "value": {
      "type": "object",
      "required": ["v", "src", "conf"],
      "additionalProperties": false,
      "properties": {"v": {"type": "number"}, "src": {"$ref": "#/$defs/src"}, "conf": {"$ref": "#/$defs/conf"}, "note": {"type": "string"}}
    },
    "rect": {
      "type": "object",
      "required": ["v", "src", "conf"],
      "additionalProperties": false,
      "description": "v = [s0, s1, v0, v1] in metres",
      "properties": {
        "v": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "src": {"$ref": "#/$defs/src"},
        "conf": {"$ref": "#/$defs/conf"},
        "note": {"type": "string"}
      }
    }
  }
}
