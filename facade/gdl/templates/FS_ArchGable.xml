		</Length>
		<Length Name="B">
			<Description><![CDATA["Depth (information only)"]]></Description>
			<Value>0.57</Value>
		</Length>
		<Length Name="ZZYZX">
			<Description><![CDATA["Overall height (information only)"]]></Description>
			<Value>1.65</Value>
		</Length>
		<Length Name="rIn">
			<Description><![CDATA["Inner radius of the ring"]]></Description>
			<Value>1.2</Value>
		</Length>
		<Length Name="rOut">
			<Description><![CDATA["Outer radius (top of the gable)"]]></Description>
			<Value>1.65</Value>
		</Length>
		<Length Name="depth">
			<Description><![CDATA["Depth of the body into the wall"]]></Description>
			<Value>0.57</Value>
		</Length>
		<Length Name="vSpring">
			<Description><![CDATA["Springing line above the arc centre (0 = semicircle)"]]></Description>
			<Value>0</Value>
		</Length>
		<Integer Name="nSeg">
			<Description><![CDATA["Segments of a half circle"]]></Description>
			<Value>24</Value>
		</Integer>
		<Boolean Name="bInfill">
			<Description><![CDATA["Infill inside the ring (closed lunette)"]]></Description>
			<Value>0</Value>
		</Boolean>
		<Length Name="infRecess">
			<Description><![CDATA["Recess of the infill behind the wall face"]]></Description>
			<Value>0.15</Value>
		</Length>
		<Material Name="matRing">
			<Description><![CDATA["Ring surface (0 = object surface)"]]></Description>
			<Value>0</Value>
		</Material>
		<Material Name="matInfill">
			<Description><![CDATA["Infill surface (0 = object surface)"]]></Description>
			<Value>0</Value>
		</Material>
	</Parameters>
</ParamSection>

<Script_1D SectVersion="20" SectionFlags="0" SubIdent="0"><![CDATA[
! FS_ArchGable 1.1 - master script
n = MAX(nSeg, 2)
vs = MAX(vSpring, 0)
aO = ASN(MIN(vs / rOut, 1))
aI = ASN(MIN(vs / rIn, 1))
xO = SQR(MAX(rOut * rOut - vs * vs, 0))
]]></Script_1D>

<Script_2D SectVersion="20" SectionFlags="0" SubIdent="0"><![CDATA[
HOTSPOT2 -xO, 0
HOTSPOT2 xO, 0
HOTSPOT2 -xO, -depth
HOTSPOT2 xO, -depth
PROJECT2 3, 270, 2
]]></Script_2D>

<Script_3D SectVersion="20" SectionFlags="0" SubIdent="0"><![CDATA[
HOTSPOT -xO, 0, vs
HOTSPOT xO, 0, vs
HOTSPOT -xO, -depth, vs
HOTSPOT xO, -depth, vs
HOTSPOT 0, 0, rOut
HOTSPOT 0, -depth, rOut

! after ROTX 90: local x = x, local y = up (z), extrusion along local z = into the wall (-y)
IF matRing > 0 THEN MATERIAL matRing
ROTX 90
FOR i = 0 TO n
	a = aO + (180 - 2 * aO) * i / n
	PUT rOut * COS(a), rOut * SIN(a), 15
NEXT i
FOR i = n TO 0 STEP -1
	a = aI + (180 - 2 * aI) * i / n
	PUT rIn * COS(a), rIn * SIN(a), 15
NEXT i
PRISM_ NSP / 3, depth, GET(NSP)
DEL 1

IF bInfill AND depth > infRecess THEN
	IF matInfill > 0 THEN MATERIAL matInfill
	ADDY -infRecess
	ROTX 90
	FOR i = 0 TO n
		a = aI + (180 - 2 * aI) * i / n
		PUT rIn * COS(a), rIn * SIN(a), 15
	NEXT i
	PRISM_ NSP / 3, depth - infRecess, GET(NSP)
	DEL 2
ENDIF
]]></Script_3D>

