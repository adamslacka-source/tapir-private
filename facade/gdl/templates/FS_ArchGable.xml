<!-- FS_ArchGable 1.1 - arched gable / archivolt above a wall (ADR-001 D5): the part of a wall above the springing
     line whose top is an arc. Units: metres. Origin = centre of the arcs in the outside wall face; x = along the
     facade, z = up, y = out of the wall plane (the body lies in y [-depth, 0]). The springing line lies vSpring
     above the centre (0 = semicircle, > 0 = segmental arch: inner chord half width sqrt(rIn^2 - vSpring^2)).
     Ring between rIn and rOut above the springing line; optional infill inside rIn (the segment between the
     springing chord and the inner arc), recessed by infRecess (a closed lunette). Polygonal arcs with nSeg segments. -->
<Ancestry SectVersion="1" SectionFlags="0" SubIdent="0" Template="false">
	<MainGUID>F938E33A-329D-4A36-BE3E-85E126820996</MainGUID>
	<MainGUID>103E8D2C-8230-42E1-9597-46F84CCE28C0</MainGUID>
</Ancestry>

<CalledMacros SectVersion="2" SectionFlags="0" SubIdent="0">
</CalledMacros>

