			<Description><![CDATA["Band projection from the wall plane"]]></Description>
			<Value>0.03</Value>
		</Length>
		<Boolean Name="bTop">
			<Description><![CDATA["Head band"]]></Description>
			<Value>1</Value>
		</Boolean>
