<!-- FS_Surround 1.0 - window / door surround (šambrána) as one object (ADR-001 D5). Units: metres.
     Origin = lower left corner of the opening in the wall face; x = along the facade, z = up,
     y = out of the wall plane. Bands project y [0, bandD]. Jambs x [-bandW, 0] and [opW, opW + bandW],
     z [0, opH]; head z [opH, opH + bandW], runs over the jambs and overhangs them by headOvh;
     bottom band z [-bandW, 0] under the jambs. -->
<Ancestry SectVersion="1" SectionFlags="0" SubIdent="0" Template="false">
	<MainGUID>F938E33A-329D-4A36-BE3E-85E126820996</MainGUID>
	<MainGUID>103E8D2C-8230-42E1-9597-46F84CCE28C0</MainGUID>
</Ancestry>

<CalledMacros SectVersion="2" SectionFlags="0" SubIdent="0">
</CalledMacros>

