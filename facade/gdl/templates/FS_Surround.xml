<Script_1D SectVersion="20" SectionFlags="0" SubIdent="0"><![CDATA[
! FS_Surround 1.0 - master script: outer extent of the bands
wl = 0
wr = 0
IF bLeft THEN wl = bandW
IF bRight THEN wr = bandW
xMin = -wl
xMax = opW + wr
IF bTop THEN
	xMin = MIN(xMin, -wl - headOvh)
	xMax = MAX(xMax, opW + wr + headOvh)
ENDIF
zMin = 0
IF bBottom THEN zMin = -bandW
zMax = opH
IF bTop THEN zMax = opH + bandW
]]></Script_1D>

<Script_2D SectVersion="20" SectionFlags="0" SubIdent="0"><![CDATA[
HOTSPOT2 0, 0
HOTSPOT2 opW, 0
HOTSPOT2 xMin, 0
HOTSPOT2 xMax, 0
HOTSPOT2 xMin, bandD
HOTSPOT2 xMax, bandD
PROJECT2 3, 270, 2
]]></Script_2D>

<Script_3D SectVersion="20" SectionFlags="0" SubIdent="0"><![CDATA[
HOTSPOT 0, 0, 0
HOTSPOT opW, 0, 0
HOTSPOT 0, 0, opH
HOTSPOT opW, 0, opH
HOTSPOT xMin, bandD, zMin
HOTSPOT xMax, bandD, zMin
HOTSPOT xMin, bandD, zMax
HOTSPOT xMax, bandD, zMax

IF matBand > 0 THEN MATERIAL matBand
IF bLeft THEN
	ADD -bandW, 0, 0
	BLOCK bandW, bandD, opH
	DEL 1
ENDIF
IF bRight THEN
	ADD opW, 0, 0
	BLOCK bandW, bandD, opH
	DEL 1
ENDIF
IF bTop THEN
	ADD -wl - headOvh, 0, opH
	BLOCK opW + wl + wr + 2 * headOvh, bandD, bandW
	DEL 1
ENDIF
IF bBottom THEN
	ADD -wl, 0, -bandW
	BLOCK opW + wl + wr, bandD, bandW
	DEL 1
ENDIF
]]></Script_3D>

<Script_PR SectVersion="20" SectionFlags="0" SubIdent="0"><![CDATA[
VALUES "opW" RANGE (0, ]
VALUES "opH" RANGE (0, ]
VALUES "bandW" RANGE (0, ]
VALUES "bandD" RANGE (0, ]
VALUES "headOvh" RANGE [0, ]
]]></Script_PR>

