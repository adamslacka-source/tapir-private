			<Value>1</Value>
		</Boolean>
		<Boolean Name="bRight">
			<Description><![CDATA["Right jamb band"]]></Description>
			<Value>1</Value>
		</Boolean>
		<Length Name="headOvh">
			<Description><![CDATA["Head overhang beyond the jambs (each side)"]]></Description>
			<Value>0</Value>
